# Start here: this mode never contacts a bank and never sends email.
PAYMENT_PROVIDER=demo
EMAIL_TRANSPORT=preview
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DB_PATH=./data/bookings.sqlite
OWNER_EMAIL=owner@example.com
MAIL_FROM=Tour Bookings <bookings@example.com>

# Real TBC API. It is NOT a free/fake-money sandbox.
# Enable only after merchant onboarding and arranging a controlled bank test.
TBC_PAYMENTS_ENABLED=false
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=

# To send real email, set EMAIL_TRANSPORT=smtp and configure the following.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# On a real host use HTTPS, HOST=0.0.0.0 and NODE_ENV=production.
# TRUST_PROXY_HOPS=1 only if exactly one trusted reverse proxy fronts this app.
TRUST_PROXY_HOPS=0
